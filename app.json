{
  "expo": {
    "name": "Sunfold",
    "slug": "sunfold",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sunfold",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.nicolaos.goldenhour",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sunfold uses your location to calculate the sunrise, sunset, golden hour and blue hour times for exactly where you are. Times are computed on your device; your coordinates go to Apple's geocoder only to name your location.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nicolaos.sunfold",
      "adaptiveIcon": {
        "backgroundColor": "#FBF4F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF4F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sunfold uses your location to calculate the sunrise, sunset, golden hour and blue hour times for exactly where you are. Times are computed on your device; your coordinates go to Apple's geocoder only to name your location.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c8f44358-7eba-4174-bd86-d86e01e8b8c4"
      }
    }
  }
}
